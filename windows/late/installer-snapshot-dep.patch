# The installer packs snapshot_blob.bin in a cross build (no V8 context snapshot), and on
# Chromium 156 gn rejects it as an input without a dependency on the action that makes it.
--- a/chrome/installer/mini_installer/BUILD.gn
+++ b/chrome/installer/mini_installer/BUILD.gn
@@ -238,7 +238,9 @@
   }
 
   if (v8_use_external_startup_data) {
-    deps += [ "//v8" ]
+    # //v8 depends on its snapshot privately, and a build cross-compiled
+    # from Linux packs snapshot_blob.bin.
+    deps += [ "//v8", "//v8:run_mksnapshot_default" ]
     if (use_v8_context_snapshot) {
       inputs += [ "$root_out_dir/$v8_context_snapshot_filename" ]
       deps += [ "//tools/v8_context_snapshot" ]
