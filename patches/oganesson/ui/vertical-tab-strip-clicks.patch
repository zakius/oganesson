+bool VerticalTabStripRegionView::OnMousePressed(const ui::MouseEvent& event) {
+  // Reaches here when no tab or button handled it: the strip's empty space.
+  if (event.IsOnlyMiddleMouseButton()) {
+    // Same as the New Tab button: the tab goes at the end of the strip.
+    chrome::NewTab(browser_view()->browser(), NewTabTypes::kNewTabButton);
+    return true;
+  }
+  return BaseTabStripRegionView::OnMousePressed(event);
+}
+
+views::View* VerticalTabStripRegionView::TargetForRect(views::View* root,
+                                                      const gfx::Rect& rect) {
+  const int padding =
+      GetLayoutConstant(LayoutConstant::kVerticalTabStripHorizontalPadding);
+  gfx::Rect target = rect;
+  // The edge away from the resize area, the window's.
+  const int x = GetMirroredXInView(rect.CenterPoint().x());
+  if (x >= 0 && x < padding) {
+    target.set_x(GetMirroredXInView(padding) - rect.width() / 2);
+  }
+  return views::ViewTargeterDelegate::TargetForRect(root, target);
+}
