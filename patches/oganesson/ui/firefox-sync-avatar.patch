+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_WIN)
+// Firefox Sync's Mozilla account must sign in again.
+class FirefoxSyncPausedStateProvider : public StateProvider {
+ public:
+  FirefoxSyncPausedStateProvider(Profile* profile,
+                                 StateObserver* state_observer)
+      : StateProvider(profile,
+                      state_observer,
+                      /*should_consider_avatar_ring=*/false) {
+    if (auto* service =
+            firefox_sync::FirefoxSyncServiceFactory::GetForProfile(profile)) {
+      subscription_ = service->AddStatusObserver(base::BindRepeating(
+          &FirefoxSyncPausedStateProvider::OnStatusChanged,
+          base::Unretained(this)));
+    }
+    active_ = ComputeActive();
+  }
+
+  // StateProvider:
+  bool IsActive() const override { return active_; }
+
+  std::u16string GetText() const override {
+    return l10n_util::GetStringUTF16(IDS_AVATAR_BUTTON_SYNC_PAUSED);
+  }
+
+  std::optional<SkColor> GetHighlightColor(
+      const ui::ColorProvider& color_provider) const override {
+    return color_provider.GetColor(kColorAvatarButtonHighlightSyncPaused);
+  }
+
+ private:
+  bool ComputeActive() const {
+    auto* service =
+        firefox_sync::FirefoxSyncServiceFactory::GetForProfile(&profile());
+    return service && service->needs_sign_in();
+  }
+
+  void OnStatusChanged() {
+    bool active = ComputeActive();
+    if (active != active_) {
+      active_ = active;
+      RequestUpdate();
+    }
+  }
+
+  bool active_ = false;
+  base::CallbackListSubscription subscription_;
+};
+#endif  // BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_WIN)
