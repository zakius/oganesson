+void ForeignSessionHandler::CloseForeignSessionTab(
+    const std::string& session_tag,
+    int32_t tab_id_value) {
+  sync_sessions::OpenTabsUIDelegate* open_tabs =
+      GetOpenTabsUIDelegate(profile_);
+  firefox_sync::FirefoxSyncService* firefox_sync =
+      firefox_sync::FirefoxSyncServiceFactory::GetForProfile(profile_);
+  const SessionID tab_id = SessionID::FromSerializedValue(tab_id_value);
+  const ::sessions::SessionTab* tab;
+  if (!open_tabs || !firefox_sync || !tab_id.is_valid() ||
+      !open_tabs->GetForeignTab(session_tag, tab_id, &tab) ||
+      tab->navigations.empty()) {
+    return;
+  }
+  // Firefox Sync's session tags are the devices' account ids.
+  firefox_sync->CloseRemoteTabs(
+      session_tag, {tab->navigations[tab->normalized_navigation_index()]
+                        .virtual_url()});
+}
