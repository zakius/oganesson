+
+void StatusView::Layout(PassKey) {
+  text_clip_->SetBoundsRect(GetContentsBounds());
+  text_->SetBounds(
+      -scroll_, 0,
+      std::max(text_clip_->width(), text_->GetPreferredSize().width()),
+      text_clip_->height());
+}
+
+void StatusView::Scroll() {
+  const int overflow = text_->width() - text_clip_->width();
+  if (overflow <= 0) {
+    return;
+  }
+  // From the end, back to the start; otherwise one step on.
+  scroll_ = scroll_ >= overflow ? 0
+                                : std::min(scroll_ + kScrollStepPixels, overflow);
+  text_->SetX(-scroll_);
+  scroll_timer_.Start(FROM_HERE,
+                      scroll_ == 0 || scroll_ == overflow ? kScrollPause
+                                                          : kScrollStepDuration,
+                      this, &StatusView::Scroll);
 }
 
