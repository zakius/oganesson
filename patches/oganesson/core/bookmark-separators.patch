+using api::bookmarks::BookmarkTreeNodeType;
+
+// Whether `extension` sees separators: Firefox add-ons and WebUI (the
+// bookmark manager) do, Chromium extensions don't (oganesson).
+bool SeesSeparators(const Extension* extension) {
+  return !extension || IsFirefoxAddon(*extension);
+}
+
+bool IsSeparator(const api::bookmarks::BookmarkTreeNode& node) {
+  return node.type == BookmarkTreeNodeType::kSeparator;
+}
+
+// The nodes as `extension` sees them (oganesson): Firefox's `type` for a
+// Firefox add-on, with a separator's URL "data:", as in Firefox; only a
+// separator's `type` for WebUI; no separators in children for a Chromium
+// extension. Only separators have a `type` here before.
+void SetFirefoxTypes(const Extension* extension,
+                     base::span<api::bookmarks::BookmarkTreeNode> nodes) {
+  const bool firefox = extension && IsFirefoxAddon(*extension);
+  for (api::bookmarks::BookmarkTreeNode& node : nodes) {
+    if (IsSeparator(node)) {
+      if (firefox) {
+        node.url = "data:";
+      }
+    } else if (firefox) {
+      node.type = node.url ? BookmarkTreeNodeType::kBookmark
+                           : BookmarkTreeNodeType::kFolder;
+    }
+    if (node.children) {
+      if (!SeesSeparators(extension)) {
+        std::erase_if(*node.children, IsSeparator);
+      }
+      SetFirefoxTypes(extension, *node.children);
+    }
+  }
+}
+
+// The same for a list of nodes, which leaves out separators for a Chromium
+// extension.
+void SetFirefoxTypes(const Extension* extension,
+                     std::vector<api::bookmarks::BookmarkTreeNode>& nodes) {
+  if (!SeesSeparators(extension)) {
+    std::erase_if(nodes, IsSeparator);
+  }
+  SetFirefoxTypes(extension, base::span(nodes));
+}
+
+// Gives a bookmark event's nodes (in `args` at `node_arg`, or none) the
+// shape a listener sees, and keeps a separator's events (`separator`) and
+// its ID in onChildrenReordered (`separator_ids`) from Chromium extensions
+// (oganesson).
+bool WillDispatchBookmarkEvent(const base::ListValue& args,
+                               std::optional<size_t> node_arg,
+                               bool separator,
+                               const std::vector<std::string>& separator_ids,
+                               content::BrowserContext*,
+                               mojom::ContextType,
+                               const Extension* extension,
+                               const base::DictValue*,
+                               std::optional<base::ListValue>& args_out,
+                               mojom::EventFilteringInfoPtr&,
+                               bool*) {
+  if (!SeesSeparators(extension)) {
+    if (separator) {
+      return false;
+    }
+    if (!separator_ids.empty()) {
+      args_out = args.Clone();
+      base::DictValue* info = (*args_out)[1].GetIfDict();
+      base::ListValue* ids = info ? info->FindList("childIds") : nullptr;
+      if (ids) {
+        ids->EraseIf([&separator_ids](const base::Value& id) {
+          return id.is_string() &&
+                 std::ranges::find(separator_ids, id.GetString()) !=
+                     separator_ids.end();
+        });
+      }
+      return true;
+    }
+  }
+  if (!node_arg || !extension) {
+    return true;  // WebUI gets the nodes as they are.
+  }
+  // The node is the argument itself (onCreated) or removeInfo's node.
+  const base::Value& arg = args[*node_arg];
+  const base::DictValue* dict = arg.GetIfDict();
+  const base::Value* value = dict && dict->Find("node") ? dict->Find("node")
+                                                        : &arg;
+  std::optional<api::bookmarks::BookmarkTreeNode> node =
+      value->is_dict()
+          ? api::bookmarks::BookmarkTreeNode::FromValue(value->GetDict())
+          : std::nullopt;
+  if (!node) {
+    return true;
+  }
+  SetFirefoxTypes(extension, base::span_from_ref(*node));
+  args_out = args.Clone();
+  if (value == &arg) {
+    (*args_out)[*node_arg] = base::Value(node->ToValue());
+  } else {
+    (*args_out)[*node_arg].GetDict().Set("node", node->ToValue());
+  }
+  return true;
+}
+
