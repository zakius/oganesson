# Helium's features oganesson carries but doesn't want, off by default (they stay available):
# Helium's services, so no Helium server is contacted unless the user turns them on (with them
# go component updates, the extension download proxy, Helium's spellcheck dictionary mirror and
# uBO's asset mirror); bangs, whose list comes from those services; Helium's update checks (updates
# come from the package repository); onboarding (a first run opens a normal window);
# fingerprint noise; and crash reports, which would go to Helium's crash server. Store extensions update through ExtensionDownloader, as update_client's
# checks are blocked. Where the extensions and dictionaries go (Google's servers, as in
# Chromium, or the user's server) is browser traffic's (browser-traffic.patch).
--- a/chrome/browser/chrome_content_browser_client.cc
+++ b/chrome/browser/chrome_content_browser_client.cc
@@ -1657,7 +1657,8 @@ void ChromeContentBrowserClient::RegisterProfilePrefs(
     user_prefs::PrefRegistrySyncable* registry) {
   registry->RegisterBooleanPref(prefs::kDisable3DAPIs, false);
   registry->RegisterBooleanPref(prefs::kEnableHyperlinkAuditing, false);
-  registry->RegisterBooleanPref(prefs::kHeliumNoiseEnabled, true);
+  // oganesson: no fingerprint noise unless the user turns it on.
+  registry->RegisterBooleanPref(prefs::kHeliumNoiseEnabled, false);
   // Register user prefs for mapping SitePerProcess and IsolateOrigins in
   // user policy in addition to the same named ones in Local State (which are
   // used for mapping the command-line flags).
--- a/chrome/browser/extensions/updater/extension_updater.cc
+++ b/chrome/browser/extensions/updater/extension_updater.cc
@@ -802,6 +802,14 @@ bool ExtensionUpdater::CanUseUpdateService(
     return false;
   }
 
+  // oganesson: update_client's checks are blocked (ungoogled-chromium's
+  // block-requests.patch), so store extensions update through
+  // ExtensionDownloader, the XML protocol the store still serves. The
+  // parentheses mark the rest as deliberately unreachable.
+  if ((true)) {
+    return false;
+  }
+
   // UpdateService can only update extensions that have been installed on the
   // system.
   // TODO(crbug.com/482088398): Eliminate this constraint.
--- a/chrome/browser/prefs/browser_prefs.cc
+++ b/chrome/browser/prefs/browser_prefs.cc
@@ -1670,9 +1670,10 @@ void RegisterLocalState(PrefRegistrySimple* registry) {
   breadcrumbs::RegisterPrefs(registry);
   browser_shutdown::RegisterPrefs(registry);
   BrowserProcessImpl::RegisterPrefs(registry);
+  // oganesson: no crash reports to Helium's server unless the user asks.
   registry->RegisterIntegerPref(
       prefs::kHeliumCrashReportingMode,
-      static_cast<int>(helium::CrashReportingMode::kAsk));
+      static_cast<int>(helium::CrashReportingMode::kDisabled));
   ChromeContentBrowserClient::RegisterLocalStatePrefs(registry);
 #if BUILDFLAG(CHROME_FOR_TESTING)
   chrome_for_testing::RegisterPrefs(registry);
--- a/chrome/browser/ui/browser_ui_prefs.cc
+++ b/chrome/browser/ui/browser_ui_prefs.cc
@@ -266,14 +266,18 @@ void RegisterBrowserUserPrefs(user_prefs::PrefRegistrySyncable* registry) {
   {
     registry->RegisterIntegerPref(prefs::kHeliumSchemaVersion, 0);
     registry->RegisterBooleanPref(prefs::kHeliumDisableSchemaAlerts, false);
-    registry->RegisterBooleanPref(prefs::kHeliumServicesEnabled, true);
-    registry->RegisterBooleanPref(prefs::kHeliumBangsEnabled, true);
+    // oganesson: no Helium servers unless the user turns them on.
+    registry->RegisterBooleanPref(prefs::kHeliumServicesEnabled, false);
+    // oganesson: the bang list comes from Helium's services.
+    registry->RegisterBooleanPref(prefs::kHeliumBangsEnabled, false);
     registry->RegisterBooleanPref(prefs::kHeliumExtProxyEnabled, true);
     registry->RegisterBooleanPref(prefs::kHeliumSpellcheckEnabled, true);
     registry->RegisterStringPref(prefs::kHeliumServicesOrigin, "");
-    registry->RegisterBooleanPref(prefs::kHeliumDidOnboarding, false);
+    // oganesson: no onboarding; a first run opens a normal window.
+    registry->RegisterBooleanPref(prefs::kHeliumDidOnboarding, true);
     registry->RegisterBooleanPref(prefs::kHeliumServicesConsented, false);
-    registry->RegisterBooleanPref(prefs::kHeliumUpdateFetchingEnabled, true);
+    // oganesson: updates come from the package repository, not Helium's.
+    registry->RegisterBooleanPref(prefs::kHeliumUpdateFetchingEnabled, false);
     registry->RegisterBooleanPref(prefs::kHeliumUBlockAssetsEnabled, true);
     registry->RegisterBooleanPref(prefs::kHeliumWebPushEnabled, true);
     registry->RegisterStringPref(prefs::kHeliumPushServer, "");
--- a/extensions/browser/pending_extension_manager.cc
+++ b/extensions/browser/pending_extension_manager.cc
@@ -236,10 +236,10 @@ std::list<std::string> PendingExtensionManager::GetPendingIdsForUpdateCheck() {
       Profile* profile = Profile::FromBrowserContext(context_.get());
       PrefService* prefs = profile->GetPrefs();
 
-      if (prefs && helium::ShouldAccessExtensionService(*prefs)) {
+      // oganesson: without Helium's proxy the URL is Google's own, so pending
+      // store installs go ahead either way.
+      if (prefs) {
         it.second.OverrideURL(helium::GetExtensionUpdateURL(*prefs));
-      } else {
-        continue;
       }
     }
 
