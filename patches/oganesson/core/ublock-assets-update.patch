# uBlock Origin refreshes its catalog of filter lists (assets.json) from GitHub again:
# the uBlock package Helium ships has no such address, and Helium serves the catalog
# through its services, which are off by default.
--- a/third_party/ublock/assets/assets.json
+++ b/third_party/ublock/assets/assets.json
@@ -3,6 +3,7 @@
 		"content": "internal",
 		"updateAfter": 13,
 		"contentURL": [
+			"https://raw.githubusercontent.com/imputnet/uBlock/refs/heads/main/assets/assets.json",
 			"assets/assets.json"
 		]
 	},
