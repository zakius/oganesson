# Settings > Appearance > App icon (oganesson.app_icon in Local State; docs/app-icon.md): one of
# the Og icon's variants for the windows, and on Linux the user's copy of the .desktop entry, on
# Windows the shortcuts. src/.../ui/app_icon has the code: started before the first window, its
# choice is each window's default icon. Linux ships the variants as PNGs in app_icons/, Windows
# as icons in chrome.exe after Chromium's own, numbered 7 to 12.
--- a/chrome/BUILD.gn
+++ b/chrome/BUILD.gn
@@ -2043,6 +2043,24 @@ if (is_linux || is_chromeos) {
           [ "//chrome/app/theme/$branding_path_component/product_logo_48.png" ]
     }
     outputs = [ "$root_out_dir/{{source_file_part}}" ]
+    if (is_linux) {
+      deps = [ ":oganesson_app_icons" ]
+    }
+  }
+
+  # oganesson: the app icon's variants, which Settings > Appearance > App icon
+  # sets (chrome/browser/ui/app_icon).
+  copy("oganesson_app_icons") {
+    sources = [
+      "//chrome/app/theme/oganesson/app_icons/black.png",
+      "//chrome/app/theme/oganesson/app_icons/clear_black.png",
+      "//chrome/app/theme/oganesson/app_icons/clear_white.png",
+      "//chrome/app/theme/oganesson/app_icons/crimson.png",
+      "//chrome/app/theme/oganesson/app_icons/orange.png",
+      "//chrome/app/theme/oganesson/app_icons/teal.png",
+      "//chrome/app/theme/oganesson/app_icons/white.png",
+    ]
+    outputs = [ "$root_out_dir/app_icons/{{source_file_part}}" ]
   }
 }
 
--- a/chrome/app/chrome_exe.rc
+++ b/chrome/app/chrome_exe.rc
@@ -81,6 +81,14 @@ IDR_X006_HTML_DOC       ICON       "theme\\chromium\\win\\chromium_doc.ico"
 IDR_X007_PDF_DOC        ICON       "theme\\chromium\\win\\chromium_pdf.ico"
 IDR_X008_ISOLATED       ICON       "theme\\chromium\\win\\isolated.ico"
 IDR_X009_OMNIBOX_EVERYWHERE ICON   "theme\\chromium\\win\\omnibox_everywhere.ico"
+// oganesson: the app icon's variants (Settings > Appearance > App icon),
+// numbered 7 to 12. chrome/browser/ui/app_icon names them.
+IDR_X010_OGANESSON_TEAL ICON       "theme\\chromium\\win\\oganesson_teal.ico"
+IDR_X011_OGANESSON_CRIMSON ICON    "theme\\chromium\\win\\oganesson_crimson.ico"
+IDR_X012_OGANESSON_BLACK ICON      "theme\\chromium\\win\\oganesson_black.ico"
+IDR_X013_OGANESSON_WHITE ICON      "theme\\chromium\\win\\oganesson_white.ico"
+IDR_X014_OGANESSON_CLEAR_WHITE ICON "theme\\chromium\\win\\oganesson_clear_white.ico"
+IDR_X015_OGANESSON_CLEAR_BLACK ICON "theme\\chromium\\win\\oganesson_clear_black.ico"
 #endif
 
 
