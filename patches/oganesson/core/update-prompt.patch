-#include "chrome/common/chrome_switches.h"
+#include "base/version.h"
+#include "base/version_info/version_info.h"
 
 namespace {
 
-// On Linux, the Chrome binary may have been replaced by an update. Ask it to
-// report its version.
+// oganesson: apt and dnf put a new file at the binary's path on every
+// upgrade, also a rebuild on the same Chromium version, which the binary's
+// --product-version can't tell from the running one. A binary at the
+// browser's path that isn't the running file is an update, reported as the
+// running version plus one (as helium-windows' get_installed_version_win.cc).
+// A binary that is gone (uninstalled) is none.
 InstalledAndCriticalVersion GetInstalledVersionSynchronous() {
-  base::CommandLine command_line(*base::CommandLine::ForCurrentProcess());
-  command_line.AppendSwitch(switches::kProductVersion);
-  base::Version installed_version;
-  std::string reply;
-  if (base::GetAppOutput(command_line, &reply)) {
-    installed_version =
-        base::Version(base::TrimWhitespaceASCII(reply, base::TRIM_ALL));
+  base::Version running = version_info::GetVersion();
+  base::FilePath exe;
+  if (!base::PathService::Get(base::FILE_EXE, &exe)) {
+    return InstalledAndCriticalVersion(std::move(running));
   }
-  // Failure may be a result of invoking a Chrome that predates the introduction
-  // of the --product-version switch in https://crrev.com/48795 (6.0.424.0).
-  DLOG_IF(ERROR, !installed_version.IsValid())
-      << "Failed to get current file version; child process replied with: "
-      << reply;
-
-  return InstalledAndCriticalVersion(std::move(installed_version));
+  // FILE_EXE reads /proc/self/exe, which names a replaced binary so.
+  std::string path = exe.value();
+  constexpr std::string_view kDeleted = " (deleted)";
+  if (base::EndsWith(path, kDeleted)) {
+    path.resize(path.size() - kDeleted.size());
+  }
+  struct stat on_disk;
+  struct stat current;
+  if (stat(path.c_str(), &on_disk) == 0 &&
+      stat("/proc/self/exe", &current) == 0 &&
+      (on_disk.st_ino != current.st_ino || on_disk.st_dev != current.st_dev)) {
+    std::vector<uint32_t> components = running.components();
+    components.back() += 1;
+    return InstalledAndCriticalVersion(base::Version(std::move(components)));
+  }
+  return InstalledAndCriticalVersion(std::move(running));
 }
 
 }  // namespace
