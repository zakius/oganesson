# The update prompt as soon as an update is installed, on both platforms: the "Update" chip and
# "Relaunch to update" show at once, not after two days (the update is already on disk and the
# running browser is the old one). On Linux, an update is a new file at the binary's path, which
# catches every apt or dnf upgrade, also a rebuild on the same Chromium version; linux/flags.gn
# turns the poller on (enable_update_notifications). Windows' poller is helium-windows'.
--- a/chrome/browser/upgrade_detector/get_installed_version_linux.cc
+++ b/chrome/browser/upgrade_detector/get_installed_version_linux.cc
@@ -4,40 +4,55 @@
 
 #include "chrome/browser/upgrade_detector/get_installed_version.h"
 
+#include <sys/stat.h>
