+void ImportDataHandler::HandleImportFromProfileFolder(
+    const base::ListValue& args) {
+  CHECK_CURRENTLY_ON(BrowserThread::UI, base::NotFatalUntil::M162);
+  CHECK_EQ(1U, args.size());
+  if (select_file_dialog_ || !profile_folder_callback_id_.empty() ||
+      !importer_list_loaded_) {
+    ResolveJavascriptCallback(args[0], base::Value());
+    return;
+  }
+  profile_folder_callback_id_ = args[0].GetString();
+  select_file_dialog_ = ui::SelectFileDialog::Create(
+      this,
+      std::make_unique<ChromeSelectFilePolicy>(web_ui()->GetWebContents()));
+  BrowserWindowInterface* browser =
+      GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(
+          web_ui()->GetWebContents());
+  select_file_dialog_->SelectFile(
+      ui::SelectFileDialog::SELECT_FOLDER, std::u16string(), base::FilePath(),
+      nullptr, 0, base::FilePath::StringType(),
+      browser->GetWindow()->GetNativeWindow(), nullptr);
+}
+
+void ImportDataHandler::OnProfileFolderScanned(int first) {
+  base::DictValue result;
+  result.Set("profiles", GetBrowserProfileList());
+  result.Set("selected", first);
+  SendProfileFolderResult(base::Value(std::move(result)));
+}
+
+void ImportDataHandler::SendProfileFolderResult(base::Value result) {
+  const std::string callback_id = std::move(profile_folder_callback_id_);
+  profile_folder_callback_id_.clear();
+  if (IsJavascriptAllowed()) {
+    ResolveJavascriptCallback(base::Value(callback_id), result);
+  }
+}
