--- a/utils/tests/test_downloads.py
+++ b/utils/tests/test_downloads.py
@@ -0,0 +1,42 @@
+# -*- coding: UTF-8 -*-
+
+import hashlib
+import subprocess
+import sys
+import zipfile
+from pathlib import Path
+
+DOWNLOADS = Path(__file__).resolve().parent.parent / 'downloads.py'
+
+
+def _unpack(tmp_path, expected=None):
+    """Unpacks a cached ZIP configured with the hash of expected, or its own."""
+    cache, output = tmp_path / 'cache', tmp_path / 'output'
+    cache.mkdir()
+    output.mkdir()
+    with zipfile.ZipFile(cache / 'a.zip', 'w') as archive:
+        archive.writestr('a.txt', 'cached bytes')
+    digest = hashlib.sha256(expected or (cache / 'a.zip').read_bytes()).hexdigest()
+    config = tmp_path / 'downloads.ini'
+    config.write_text('[test]\nurl = https://invalid.example/a.zip\ndownload_filename = a.zip\n'
+                      f'output_path = ./\nsha256 = {digest}\n')
+    result = subprocess.run(
+        [sys.executable,
+         str(DOWNLOADS), 'unpack', '-i',
+         str(config), '-c',
+         str(cache),
+         str(output)],
+        check=False)
+    return result.returncode, output / 'a.txt'
+
+
+def test_unpack_checks_hashes(tmp_path):
+    returncode, extracted = _unpack(tmp_path, b'other bytes')
+    assert returncode == 1
+    assert not extracted.exists()
+
+
+def test_unpack_matching_hash(tmp_path):
+    returncode, extracted = _unpack(tmp_path)
+    assert returncode == 0
+    assert extracted.read_text() == 'cached bytes'
--- a/utils/tests/test_name_substitution_utils.py
+++ b/utils/tests/test_name_substitution_utils.py
@@ -0,0 +1,23 @@
+# -*- coding: UTF-8 -*-
+
+import xml.etree.ElementTree as xml
+
+from .. import name_substitution_utils as util
+
+
+def test_xtb_rekeys_translations_without_a_replacement():
+    xtb = ('<translationbundle lang="ko">'
+           '<translation id="1">Chromium에서는 이 확장 프로그램을 검토할 것을 권장합니다.</translation>'
+           '<translation id="2">이 확장 프로그램을 검토하세요.</translation>'
+           '<translation id="3">Chromium을 사용하세요</translation>'
+           '</translationbundle>')
+    result = util.replace_xtb_tree(xtb, {'1': '10', '2': '20'})
+    assert result is not None
+    translations = xml.fromstring(result).findall('translation')
+    assert [t.get('id') for t in translations] == ['10', '20', '3']
+    assert translations[0].text.startswith('Chromium에서는')
+
+
+def test_xtb_unchanged_without_mapped_ids():
+    xtb = '<translationbundle><translation id="1">이 확장 프로그램</translation></translationbundle>'
+    assert util.replace_xtb_tree(xtb, {'2': '20'}) is None
