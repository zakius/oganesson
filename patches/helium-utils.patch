+def gsutil_over_https(_gsutil, command, url, output_file=None):
+    """Stand in for depot_tools' gsutil.py on public buckets.
+
+    gsutil.py needs vpython3 and luci-auth, which the build container lacks,
+    and domain substitution breaks its URLs. gclient still checks the
+    archive's hash and size, and extracts it.
+    """
+    if command == "stat":
+        # Only read for the executable bit, which an archive doesn't need.
+        return 0, "", ""
+    assert command == "cp" and url.startswith("gs://"), (command, url)
+    with urllib.request.urlopen("https://storage.googleapis.com/" + url[len("gs://"):]) as response:
+        with open(output_file, "wb") as output:
+            shutil.copyfileobj(response, output)
+    return 0, "", ""
+
+
