# dubna's app_links_platform.h for the desktop browser. dubna's app-links.patch
# makes the browser depend on this.
source_set("platform") {
  sources = [ "desktop_platform.cc" ]
  public_deps = [ "//chrome/browser/app_links" ]
  deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    "//content/public/browser",
    "//url",
  ]
}
