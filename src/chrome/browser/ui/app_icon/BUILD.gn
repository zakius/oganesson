# Settings > Appearance > App icon (docs/app-icon.md).
source_set("app_icon") {
  sources = [
    "oganesson_app_icon.cc",
    "oganesson_app_icon.h",
  ]
  deps = [
    "//base",
    "//chrome/browser/ui/browser_window",
    "//components/prefs",
    "//ui/base",
    "//ui/gfx",
    "//ui/views",
  ]
  if (is_linux) {
    sources += [ "oganesson_app_icon_linux.cc" ]
    deps += [
      "//chrome/app/theme:chrome_unscaled_resources",
      "//chrome/common:channel_info",
    ]
  }
  if (is_win) {
    sources += [ "oganesson_app_icon_win.cc" ]
    deps += [ "//chrome/browser/win" ]
  }
}
