<grit-part>
      <message name="IDS_SETTINGS_SHORTCUTS_AND_GESTURES_TITLE" desc="Title of the Settings subpage and row for assigning keyboard shortcuts and mouse gestures to browser commands.">
        Shortcuts and gestures
      </message>
      <message name="IDS_SETTINGS_SHORTCUTS_EXTENSION_COMMANDS" desc="Heading above the list of extension commands that mouse gestures can run, on the Settings shortcuts page.">
        Extension commands
      </message>
      <message name="IDS_SETTINGS_SHORTCUTS_ADD_GESTURE" desc="Button on a browser command row that opens a dialog to assign a mouse gesture to the command.">
        Add gesture
      </message>
      <message name="IDS_SETTINGS_SHORTCUTS_ADD_GESTURE_DIALOG_TITLE" desc="Title of the dialog for assigning a mouse gesture to a browser command.">
        Add mouse gesture
      </message>
      <message name="IDS_SETTINGS_SHORTCUTS_GESTURE_DESCRIPTION" desc="Explains how to draw a mouse gesture and how to type one in the add mouse gesture dialog.">
        Hold the right mouse button, draw, then release. Type the gesture as a sequence of L, R, U, and D (left, right, up, down), for example DR.
      </message>
      <message name="IDS_SETTINGS_SHORTCUTS_FALLBACK" desc="Note on a keyboard shortcut on the Settings shortcuts page that runs its command only while no other command has the shortcut.">
        when free
      </message>
      <message name="IDS_SETTINGS_SHORTCUTS_FALLBACK_TOOLTIP" desc="Tooltip of a keyboard shortcut on the Settings shortcuts page that runs its command only while no other command has the shortcut.">
        Runs this command while no other command has the shortcut. Add it to another command to change what it does.
      </message>
      <message name="IDS_SETTINGS_SHORTCUTS_OVERRIDDEN" desc="Note on a keyboard shortcut on the Settings shortcuts page that runs its command only while no other command has the shortcut, while another command has it.">
        overridden by <ph name="COMMAND">$1<ex>Copy URL</ex></ph>
      </message>
      <message name="IDS_SETTINGS_SHORTCUTS_OVERRIDDEN_TOOLTIP" desc="Tooltip of a keyboard shortcut on the Settings shortcuts page that runs its command only while no other command has the shortcut, while another command has it.">
        <ph name="COMMAND">$1<ex>Copy URL</ex></ph> has this shortcut. It runs this command again once no command has it.
      </message>
      <message name="IDS_SETTINGS_SHORTCUTS_SHARED" desc="Note on an extension command's media key on the Settings shortcuts page, while other extension commands have the same media key and it runs each of them.">
        shared with <ph name="COMMANDS">$1<ex>Media control: Next track</ex></ph>
      </message>
      <message name="IDS_SETTINGS_SHORTCUTS_WILL_SHARE" desc="Note shown while recording a media key for an extension command on the Settings shortcuts page, when other extension commands have it. Several extension commands can have a media key.">
        <ph name="COMMANDS">$1<ex>Media control: Next track</ex></ph> also has this key. Both keep it, and it runs both.
      </message>
      <message name="IDS_SETTINGS_SHORTCUTS_GESTURE_LABEL" desc="Label of the text field where the user types a mouse gesture, such as DR.">
        Gesture
      </message>
      <message name="IDS_SETTINGS_SHORTCUTS_GESTURE_STROKE" desc="Option in the mouse gesture type menu for a gesture drawn while holding the right mouse button.">
        Draw with the right button
      </message>
      <message name="IDS_SETTINGS_SHORTCUTS_GESTURE_ROCKER_RIGHT_LEFT" desc="Mouse gesture: hold the right mouse button, then click the left mouse button.">
        Hold right, click left
      </message>
      <message name="IDS_SETTINGS_SHORTCUTS_GESTURE_ROCKER_LEFT_RIGHT" desc="Mouse gesture: hold the left mouse button, then click the right mouse button.">
        Hold left, click right
      </message>
      <message name="IDS_SETTINGS_SHORTCUTS_GESTURE_WHEEL_UP" desc="Mouse gesture: hold the right mouse button and scroll the wheel up.">
        Hold right, scroll up
      </message>
      <message name="IDS_SETTINGS_SHORTCUTS_GESTURE_WHEEL_DOWN" desc="Mouse gesture: hold the right mouse button and scroll the wheel down.">
        Hold right, scroll down
      </message>
</grit-part>
