<!-- Containers: separate cookies and site data within one profile. -->
<grit-part>
  <message name="IDS_OGANESSON_CONTAINERS_OPEN_LINK" desc="Link context menu: submenu that opens the link in a new tab in a container the user picks. A container keeps its own cookies and site data.">
    Open link in container
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_REOPEN" desc="Tab context menu: submenu that reopens the tab in a container the user picks, in place of the tab.">
    Reopen in container
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_NEW_TAB" desc="New Tab button's context menu: submenu that opens a new tab in a container the user picks.">
    New tab in container
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_OPEN_BOOKMARKS" desc="Bookmark context menu: submenu that opens the bookmarks in new tabs in a container the user picks.">
    Open in container
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_NONE" desc="Container submenus: opens the page outside containers, with the profile's own cookies and site data.">
    No container
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_NEW_TEMPORARY" desc="Container submenus: opens the page in a new temporary container, whose cookies and site data are deleted once its tabs are closed.">
    New temporary container
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_MANAGE" desc="Container submenus: opens Settings' page of containers.">
    Manage containers…
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_PAGE_ACTION" desc="Tooltip of the address bar icon of a tab that is in a container. Clicking the icon opens a menu to reopen the tab in another container.">
    Container: <ph name="CONTAINER">$1<ex>Work</ex></ph>
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_TITLE" desc="Settings: title of the page and of the row that opens it, under Privacy and security.">
    Containers
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_DESCRIPTION" desc="Settings: description of the Containers row.">
    Separate cookies and site data for tabs in each container
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_ADD" desc="Settings, Containers page: button that adds a container.">
    Add container
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_EDIT" desc="Settings, Containers page: title of the dialog that changes a container.">
    Edit container
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_NAME" desc="Settings, Containers page: label of the container's name field.">
    Name
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_COLOR" desc="Settings, Containers page: label of the container's colors to pick from.">
    Color
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_ICON" desc="Settings, Containers page: label of the container's icons to pick from.">
    Icon
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_COLOR_BLUE" desc="Settings, Containers page: name of a container color, read by screen readers on its button.">
    Blue
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_COLOR_TURQUOISE" desc="Settings, Containers page: name of a container color, read by screen readers on its button.">
    Turquoise
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_COLOR_GREEN" desc="Settings, Containers page: name of a container color, read by screen readers on its button.">
    Green
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_COLOR_YELLOW" desc="Settings, Containers page: name of a container color, read by screen readers on its button.">
    Yellow
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_COLOR_ORANGE" desc="Settings, Containers page: name of a container color, read by screen readers on its button.">
    Orange
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_COLOR_RED" desc="Settings, Containers page: name of a container color, read by screen readers on its button.">
    Red
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_COLOR_PINK" desc="Settings, Containers page: name of a container color, read by screen readers on its button.">
    Pink
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_COLOR_PURPLE" desc="Settings, Containers page: name of a container color, read by screen readers on its button.">
    Purple
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_ICON_FINGERPRINT" desc="Settings, Containers page: name of a container icon, read by screen readers on its button. The names are those of Firefox Multi-Account Containers.">
    Fingerprint
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_ICON_BRIEFCASE" desc="Settings, Containers page: name of a container icon, read by screen readers on its button. The names are those of Firefox Multi-Account Containers.">
    Briefcase
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_ICON_DOLLAR" desc="Settings, Containers page: name of a container icon, read by screen readers on its button. The names are those of Firefox Multi-Account Containers.">
    Dollar sign
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_ICON_CART" desc="Settings, Containers page: name of a container icon, read by screen readers on its button. The names are those of Firefox Multi-Account Containers.">
    Cart
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_ICON_CIRCLE" desc="Settings, Containers page: name of a container icon, read by screen readers on its button. The names are those of Firefox Multi-Account Containers.">
    Circle
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_ICON_GIFT" desc="Settings, Containers page: name of a container icon, read by screen readers on its button. The names are those of Firefox Multi-Account Containers.">
    Gift
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_ICON_VACATION" desc="Settings, Containers page: name of a container icon, read by screen readers on its button. The names are those of Firefox Multi-Account Containers.">
    Vacation
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_ICON_PET" desc="Settings, Containers page: name of a container icon, read by screen readers on its button. The names are those of Firefox Multi-Account Containers.">
    Pet
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_ICON_CHILL" desc="Settings, Containers page: name of a container icon, read by screen readers on its button. The names are those of Firefox Multi-Account Containers.">
    Chill
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_ICON_FENCE" desc="Settings, Containers page: name of a container icon, read by screen readers on its button. The names are those of Firefox Multi-Account Containers.">
    Fence
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_DELETE_TITLE" desc="Settings, Containers page: title of the dialog that confirms deleting a container.">
    Delete <ph name="CONTAINER">$1<ex>Work</ex></ph>?
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_DELETE_BODY" desc="Settings, Containers page: what deleting a container does.">
    Its tabs close, and its cookies and site data are deleted.
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_NONE_YET" desc="Settings, Containers page: shown when the user has no containers.">
    No containers
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_NEW_TABS" desc="Settings, Containers page: label of the choice of where new tabs open: outside containers, in a container, or in a new temporary container.">
    Open new tabs in
  </message>
  <message name="IDS_OGANESSON_TRAFFIC_CONTROL_TITLE" desc="Settings, Containers page: title of the section of Traffic Control rules, which open matching sites in a chosen container.">
    Traffic Control
  </message>
  <message name="IDS_OGANESSON_TRAFFIC_CONTROL_DESCRIPTION" desc="Settings, Containers page: what Traffic Control rules do.">
    Sites that match a rule always open in its container, whichever tab they start in.
  </message>
  <message name="IDS_OGANESSON_TRAFFIC_CONTROL_ADD" desc="Settings, Containers page: button that adds a Traffic Control rule.">
    Add rule
  </message>
  <message name="IDS_OGANESSON_TRAFFIC_CONTROL_EDIT" desc="Settings, Containers page: title of the dialog that changes a Traffic Control rule.">
    Edit rule
  </message>
  <message name="IDS_OGANESSON_TRAFFIC_CONTROL_SITES" desc="Settings, Traffic Control rule dialog: label of the field of site patterns, one per line.">
    Sites, one per line
  </message>
  <message name="IDS_OGANESSON_TRAFFIC_CONTROL_SITES_INVALID" desc="Settings, Traffic Control rule dialog: error under the sites field when a line isn't a valid pattern.">
    Enter sites such as example.com or https://*.example.org/path
  </message>
  <message name="IDS_OGANESSON_TRAFFIC_CONTROL_OPEN_IN" desc="Settings, Traffic Control rule dialog: label of the container the sites open in.">
    Open in
  </message>
  <message name="IDS_OGANESSON_TRAFFIC_CONTROL_NONE" desc="Settings, Traffic Control: a rule's target that opens sites outside containers.">
    No container
  </message>
  <message name="IDS_OGANESSON_TRAFFIC_CONTROL_TEMPORARY" desc="Settings, Traffic Control: a rule's target that opens sites in a new temporary container each time.">
    New temporary container
  </message>
  <message name="IDS_OGANESSON_TRAFFIC_CONTROL_NONE_YET" desc="Settings, Containers page: shown when there are no Traffic Control rules.">
    No rules
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_NEW_TABS_ASK" desc="Settings, Containers page: a choice of where new tabs open: a click on the New Tab button shows the menu of containers to open the tab in.">
    Ask every time
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_COMMAND_CURRENT" desc="Settings, keyboard shortcuts page: command that opens a new tab in the container of the tab that is shown.">
    New tab in the current tab's container
  </message>
  <message name="IDS_OGANESSON_CONTAINERS_COMMAND_NTH" desc="Settings, keyboard shortcuts page: command that opens a new tab in the container at this place in the user's list of containers. $1 is a number from 1 to 9.">
    New tab in container <ph name="NUMBER">$1<ex>1</ex></ph>
  </message>
</grit-part>
