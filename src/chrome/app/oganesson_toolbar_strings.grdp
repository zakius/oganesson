<grit-part>
  <message name="IDS_OGANESSON_TOOLBAR_ITEM_BACK" desc="Name of the Back button in the Customize toolbar side panel, where it can be shown or hidden.">
    Back
  </message>
  <message name="IDS_OGANESSON_TOOLBAR_ITEM_RELOAD" desc="Name of the Reload button in the Customize toolbar side panel, where it can be shown or hidden.">
    Reload
  </message>
  <message name="IDS_OGANESSON_TOOLBAR_ITEM_LOCATION_BAR" desc="Name of the address and search bar in the Customize toolbar side panel, where it can be shown or hidden.">
    Address bar
  </message>
  <message name="IDS_OGANESSON_TOOLBAR_ITEM_EXTENSIONS" desc="Name of the Extensions button (the puzzle piece) in the Customize toolbar side panel, where it can be shown or hidden.">
    Extensions
  </message>
  <message name="IDS_OGANESSON_TOOLBAR_ITEM_AVATAR" desc="Name of the profile (avatar) button in the Customize toolbar side panel, where it can be shown or hidden.">
    Profile
  </message>
  <message name="IDS_OGANESSON_TOOLBAR_ITEM_APP_MENU" desc="Name of the main menu button in the Customize toolbar side panel, where it can be shown or hidden. When hidden, a right click on the toolbar opens the menu.">
    Menu
  </message>
  <message name="IDS_OGANESSON_SHOW_TAB_AUDIO_INDICATOR" desc="Label for the toggle in Settings, Appearance, that shows or hides the speaker icon on tabs that play sound. The icon for a muted tab shows either way.">
    Show sound icon on tabs
  </message>
</grit-part>
