<grit-part>
  <message name="IDS_OGANESSON_TOOLBAR_ITEM_LOCATION_BAR" desc="Name of the address and search bar in the Customize toolbar side panel, where it can be shown or hidden.">
    Address bar
  </message>
  <message name="IDS_OGANESSON_SHOW_TAB_AUDIO_INDICATOR" desc="Label for the toggle in Settings, Appearance, that shows or hides the speaker icon on tabs that play sound. The icon for a muted tab shows either way.">
    Show sound icon on tabs
  </message>
</grit-part>
