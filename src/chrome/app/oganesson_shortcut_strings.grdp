<grit-part>
  <message name="IDS_SHORTCUT_COMMAND_CYCLE_NEXT_MRU_TAB" desc="Command name shown on the Settings shortcuts page for the Ctrl+Tab command when it switches tabs in order of most recent use.">
    Cycle to recently used tab
  </message>
  <message name="IDS_SHORTCUT_COMMAND_CYCLE_PREVIOUS_MRU_TAB" desc="Command name shown on the Settings shortcuts page for the Ctrl+Shift+Tab command when it switches tabs in reverse order of most recent use.">
    Cycle to recently used tab in reverse
  </message>
  <message name="IDS_SHORTCUT_COMMAND_SCROLL_TO_TOP" desc="Command name shown on the Settings shortcuts page for scrolling to the top of the page.">
    Scroll to top of page
  </message>
  <message name="IDS_SHORTCUT_COMMAND_SCROLL_TO_BOTTOM" desc="Command name shown on the Settings shortcuts page for scrolling to the bottom of the page.">
    Scroll to bottom of page
  </message>
</grit-part>
