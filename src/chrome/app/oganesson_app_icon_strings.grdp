    Teal
  </message>
  <message name="IDS_OGANESSON_APP_ICON_CRIMSON" desc="Settings, Appearance: option of the App icon dropdown: the icon in white on a dark crimson square.">
    Crimson
  </message>
  <message name="IDS_OGANESSON_APP_ICON_BLACK" desc="Settings, Appearance: option of the App icon dropdown: the icon in white on a black square.">
    Black
  </message>
  <message name="IDS_OGANESSON_APP_ICON_WHITE" desc="Settings, Appearance: option of the App icon dropdown: the icon in black on a white square.">
    White
  </message>
  <message name="IDS_OGANESSON_APP_ICON_CLEAR_WHITE" desc="Settings, Appearance: option of the App icon dropdown: the icon alone, in white, with no square behind it.">
