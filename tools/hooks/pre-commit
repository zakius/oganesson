#!/bin/sh
# The checks that need no Docker, build or browser, about two seconds in all.
# Enable once per clone: git config core.hooksPath tools/hooks
set -e
cd "$(git rev-parse --show-toplevel)"
for check in check_mouse_gestures test_job_lock test_pack; do
    python3 "tools/$check.py" > /dev/null || { echo "pre-commit: tools/$check.py failed" >&2; exit 1; }
done
python3 dubna/tools/translate.py --check dubna . > /dev/null || { python3 dubna/tools/translate.py --check dubna . >&2; exit 1; }
python3 tools/grit_fixups.py --test > /dev/null || { echo "pre-commit: tools/grit_fixups.py --test failed" >&2; exit 1; }
