# Serves the release tree's work/dl (linux/pack.sh's packages) on port 8000,
# for the tailnet.
[Unit]
Description=oganesson package downloads (work/dl)

[Service]
ExecStart=/usr/bin/python3 -m http.server 8000 --directory %h/dev/oganesson/work/dl
Restart=on-failure

[Install]
WantedBy=default.target
